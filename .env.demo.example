# Demo-friendly env (copy to .env.demo)
#
# This profile aims to keep the startup gate clean and predictable for interviews.
# It avoids weak default keys and disables heavy warmups via start_demo.sh.

# Core auth keys (use strong values for demo)
AEGIS_API_KEY="demo-CHANGE-ME-32chars-min"
FILES_API_KEY="demo-CHANGE-ME-32chars-min"
ADMIN_API_KEY="demo-CHANGE-ME-32chars-min"

# Keep auth on (recommended)
AEGIS_AUTH_MODE=on

# CORS: add your demo origins (Vite dev server + backend)
AEGIS_CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000"

# DB (optional). If unset, app can still run with AEGIS_DISABLE_DB=1.
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/aegis"

# Image backend (optional)
# AEGIS_IMAGE_ENDPOINT="http://127.0.0.1:8188/prompt"
# AEGIS_IMAGE_CKPT="DreamShaper_8_pruned.safetensors"
# AEGIS_IMAGE_TIMEOUT=90

# Web providers (optional)
AEGIS_SEARCH_PROVIDERS="brave_html,startpage_html,qwant_html"
AEGIS_SEARCH_TIMEOUT=8

# Disable DB easily for demos:
# AEGIS_DISABLE_DB=1

# Optional: allow clean local shutdown via POST /system/shutdown
# (requires ADMIN_API_KEY)
AEGIS_ENABLE_SHUTDOWN_ENDPOINT=1
