# Copy to .env.production and replace values.
# This profile is intended for strict validation / production posture.

AEGIS_RUNTIME_PROFILE=strict
AEGIS_AUTH_MODE=on

# Use strong keys (>= 24 chars, non-default).
AEGIS_API_KEY="replace-with-strong-random-key-32plus"
FILES_API_KEY="replace-with-strong-random-key-32plus"
ADMIN_API_KEY="replace-with-strong-random-key-32plus"

# Restrict CORS to your real origins (no wildcard).
AEGIS_CORS_ORIGINS="https://aegis.example.com"

# Enable HSTS when behind HTTPS reverse proxy.
AEGIS_HSTS_SECONDS=31536000

# Strict AV posture.
FILES_AV_FAIL_OPEN=0

# Browser runtime override (optional if auto-detect works).
# AEGIS_BROWSER_BINARY="/usr/bin/google-chrome"

# Required for strict image capability checks.
AEGIS_IMAGE_ENDPOINT="http://127.0.0.1:8188/prompt"
AEGIS_IMAGE_CKPT="DreamShaper_8_pruned.safetensors"
AEGIS_IMAGE_TIMEOUT=90

# Optional DB (recommended in production).
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/aegis"

